# --- deployment ---
# Throwaway wallet with testnet ETH. NOT your real wallet — this key lands in a
# file and in Vercel. Ownership is handed to ADMIN_ADDRESS after deploy.
PRIVATE_KEY=
# Your real wallet. It is OFFERED ownership; accept from that wallet afterwards.
ADMIN_ADDRESS=

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=
BASESCAN_API_KEY=

# --- randomness ---
# From https://docs.chain.link/vrf/v2-5/supported-networks — do not guess these.
# Leave blank to deploy a mock coordinator (draws become operator-triggered).
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=

# --- payment token ---
# Leave blank to deploy a mintable test token plus the in-app faucet (what you
# want for a beta — testers can't source testnet USDC).
USDC_ADDRESS=

# --- round parameters ---
# 172800 = 2 days. Keep it short for beta or testers never see a draw.
ROUND_DURATION_SECONDS=172800
BASE_PRICE_USD=1
# Growth per sale in basis points of the current price (100 = 1%). Compounds.
# 200 = 2%: a $1 ticket is ~$7.24 by the 100th sale.
PRICE_INCREMENT_BPS=200
