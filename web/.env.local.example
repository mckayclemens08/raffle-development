NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_LOTTERY_ADDRESS=
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=11155111

# Dev only: one-click wallet impersonation against a local hardhat node.
# Never set this to true for a real deployment.
NEXT_PUBLIC_DEV_WALLETS=false
NEXT_PUBLIC_COMPLIANCE_ADDRESS=

# Server-only. Backend signer that attests completed KYC to the registry.
# Must be a registry verifier. Never commit a funded key.
COMPLIANCE_VERIFIER_KEY=
# Local only: simulate an IP-geo country, since there's no geo proxy in dev.
COMPLIANCE_DEV_COUNTRY=CA

# --- Infrastructure (see "Running our own infrastructure" in the README) ---
# Our own node first; the fallback is a safety net, not the critical path.
# Leaving both blank uses the chain's public default RPC.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_RPC_FALLBACK_URL=

# Path to a locally held geolocation database (MaxMind GeoIP2 / IP2Location).
# Unset means the app falls back to CDN headers, which is coarser.
GEOIP_DATABASE_PATH=

# Beta: shows the "get test dollars" button. Set by the testnet deploy script
# only when it deployed a mintable mock token.
NEXT_PUBLIC_FAUCET_ENABLED=false
